{
    "name": "shopreviews-com/magento2",
    "description": "Shopreviews.com extension for Magento 2",
    "type": "magento2-module",
    "version": "1.1.1",
    "license": [
        "OSL-3.0"
    ],
    "require": {
        "magento/framework": ">=100.1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Shopreviews\\Connect\\": ""
        }
    },
    "extra": {
        "magmodules": {
            "module-name": {
                "en": "Shopreview",
                "nl": "Shopreview"
            },
            "links": {
                "product": {
                    "en": "https://www.magmodules.eu/magento2-shopreview-com.html",
                    "nl": "https://www.magmodules.nl/magento2-shopreview-com.html"
                },
                "docs": {
                    "en": "https://www.magmodules.eu/help/magento2-shopreview-com.html",
                    "nl": "https://www.magmodules.nl/help/magento2-shopreview-com.html"
                },
                "support": {
                    "en": "https://www.magmodules.eu/contact.html",
                    "nl": "https://www.magmodules.nl/contact.html"
                }
            }
        }
    }
}

